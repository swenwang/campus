{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["./scripts", "./test", "./typechain-types", "hardhat.config.ts"],
  "exclude": ["node_modules"]
}
